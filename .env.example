# --- Core -----------------------------------------------------------------
DATABASE_URL=postgresql://proxy:proxy@localhost:5433/proxy
# Hosted Postgres (Supabase): the CA certificate the server must chain to (PEM text or base64 of it); see src/lib/db-config.ts
DATABASE_CA_CERT=
# Migrations only, when DATABASE_URL is a transaction pooler (Supabase: the session-pooler URL, port 5432)
DIRECT_URL=
# Postgres pool size per instance (default 20)
DB_POOL_SIZE=20
REDIS_URL=redis://localhost:6380            # optional; in-memory fallback when unset
APP_URL=http://localhost:3000
SESSION_SECRET=                              # 32+ chars (openssl rand -base64 48)
ENCRYPTION_KEY=                              # 32 bytes base64 (openssl rand -base64 32) - encrypts upstream provider secrets
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now-please

# --- Billing --------------------------------------------------------------
STRIPE_SECRET_KEY=                           # optional in dev; billing UI shows "Stripe not configured"
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ----------------------------------------------------------------
SMTP_URL=                                    # optional (smtp://user:pass@host:587); console + EmailOutbox fallback
EMAIL_FROM="ProviderProxy <no-reply@example.com>"

# --- Cron / dev -----------------------------------------------------------
CRON_SECRET=                                 # only for the optional Cloud Scheduler routes /api/cron/* (background jobs run during calls without it)
MOCK_UPSTREAM_URL=http://localhost:4010      # dev seed creates a "Mock Upstream" provider pointing here
